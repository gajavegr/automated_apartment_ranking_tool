# Google Sheets API
GOOGLE_SHEETS_CREDENTIALS_PATH=credentials/google_sheets_credentials.json
GOOGLE_SHEET_ID=your_google_sheet_id_here

# Cross-environment data sync (optional)
# Point this at the OTHER environment's Google Sheet to let users detect and
# import data they previously entered there (e.g. staging importing from prod).
# The shared service account is already an Editor on both sheets, so no new
# credentials are needed. Leave blank to disable the feature entirely.
PEER_GOOGLE_SHEET_ID=
# Set to true when the peer sheet uses per-user namespaced tabs (multi-user
# staging). Leave false when the peer is the single-user prod sheet.
PEER_IS_MULTI_USER=false
# Friendly name for the peer environment, shown in the sync UI.
PEER_ENV_LABEL=production

# Flask session secret key (required for multi-user login)
# Signs the login session cookie. Use a stable random value in any multi-worker
# / production deployment so sessions survive restarts and all gunicorn workers
# share the same key. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
# (Local single-process dev falls back to a random key if this is unset.)
FLASK_SECRET_KEY=your_random_secret_here

# Anthropic Claude API
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Google Maps API (with Places, Distance Matrix, and Street View enabled)
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Your work location for commute calculation
YOUR_WORK_ADDRESS=4100 E 3rd Ave, Foster City, CA 94404

# Partner's work location
PARTNER_WORK_ADDRESS=1355 Market St, San Francisco, CA 94103

# Partner commute preferences (transit, walking, bicycling, driving)
PARTNER_COMMUTE_MODE=transit
PARTNER_COMMUTE_FALLBACK_MODE=walking

# SF OpenData API (no key required, but you can add endpoint if it changes)
SF_OPENDATA_API_ENDPOINT=https://data.sfgov.org/resource/wg3w-h783.json

# Cache settings
CACHE_DIR=.cache
CACHE_EXPIRE_HOURS=168  # 1 week

# Zillow listing search (automated candidate import) — OPTIONAL
# Zillow has no official search API and blocks scraping, so this goes through a
# third-party scraper API. Get a key from RapidAPI (e.g. the "Zillow.com"
# / zillow-com1 API). Leave disabled to keep manual entry only.
ZILLOW_SEARCH_ENABLED=false
ZILLOW_RAPIDAPI_KEY=your_rapidapi_key_here
ZILLOW_RAPIDAPI_HOST=zillow-com1.p.rapidapi.com
ZILLOW_DEFAULT_LOCATION=San Francisco, CA

# DataSF property enrichment (SF Assessor secured property tax roll) — FREE
# Public dataset, no key required. Optionally set a Socrata app token to raise
# anonymous rate limits (create one at https://data.sfgov.org).
DATASF_ASSESSOR_ENDPOINT=https://data.sfgov.org/resource/wv5m-vpq2.json
DATASF_APP_TOKEN=


# Google Sheets API
GOOGLE_SHEETS_CREDENTIALS_PATH=credentials/google_sheets_credentials.json
GOOGLE_SHEET_ID=your_google_sheet_id_here

# Cross-environment data sync (optional) — the OTHER environment's Google Sheet ID.
# Set this to the sheet used by the other deployment (e.g. on staging, point it at
# the production sheet) so users can detect and import data they entered there.
# The shared service account must be an Editor on both sheets. Leave blank to
# disable the sync feature entirely (endpoints no-op, UI hidden).
PEER_GOOGLE_SHEET_ID=

# Flask session secret key (required for multi-user login)
# Signs the login session cookie. Use a stable random value in any multi-worker
# / production deployment so sessions survive restarts and all gunicorn workers
# share the same key. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
# (Local single-process dev falls back to a random key if this is unset.)
FLASK_SECRET_KEY=your_random_secret_here

# Anthropic Claude API
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Google Maps API (with Places, Distance Matrix, and Street View enabled)
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Your work location for commute calculation
YOUR_WORK_ADDRESS=4100 E 3rd Ave, Foster City, CA 94404

# Partner's work location
PARTNER_WORK_ADDRESS=1355 Market St, San Francisco, CA 94103

# Partner commute preferences (transit, walking, bicycling, driving)
PARTNER_COMMUTE_MODE=transit
PARTNER_COMMUTE_FALLBACK_MODE=walking

# SF OpenData API (no key required, but you can add endpoint if it changes)
SF_OPENDATA_API_ENDPOINT=https://data.sfgov.org/resource/wg3w-h783.json

# Cache settings
CACHE_DIR=.cache
CACHE_EXPIRE_HOURS=168  # 1 week


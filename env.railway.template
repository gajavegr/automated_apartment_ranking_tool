# Railway Environment Variables Template
# Copy these values to Railway's "Variables" tab in your service settings
# DO NOT commit your actual .env file with real values!

# ============================================================================
# REQUIRED - App will not work without these
# ============================================================================

# Google Sheet ID (from your spreadsheet URL)
# Example: If URL is https://docs.google.com/spreadsheets/d/1abc123.../edit
# Then GOOGLE_SHEET_ID=1abc123...
GOOGLE_SHEET_ID=

# Anthropic Claude API Key
# Get from: https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Google Maps API Key
# Get from: https://console.cloud.google.com/apis/credentials
# Must have enabled: Maps JavaScript API, Places API, Distance Matrix API, Geocoding API
GOOGLE_MAPS_API_KEY=

# Google Sheets Credentials (JSON)
# IMPORTANT: Copy the ENTIRE contents of credentials/google_sheets_credentials.json
# Railway will handle the multi-line value automatically
# You can paste it directly into Railway's variable editor
# 
# NOTE: Do NOT set GOOGLE_SHEETS_CREDENTIALS_PATH in Railway!
# Railway may suggest it, but our code handles it automatically:
# - Sets GOOGLE_SHEETS_CREDENTIALS_JSON → code writes to /tmp/google_sheets_credentials.json
# - Leave GOOGLE_SHEETS_CREDENTIALS_PATH unset in Railway
GOOGLE_SHEETS_CREDENTIALS_JSON=

# ============================================================================
# OPTIONAL - These have sensible defaults
# ============================================================================

# Your work location for commute calculations
YOUR_WORK_ADDRESS=4100 E 3rd Ave, Foster City, CA 94404

# Partner's work location
PARTNER_WORK_ADDRESS=1355 Market St, San Francisco, CA 94103

# Partner's commute preferences
# Options: transit, walking, bicycling, driving
PARTNER_COMMUTE_MODE=transit
PARTNER_COMMUTE_FALLBACK_MODE=walking

# Commute departure times (24-hour format)
AM_DEPARTURE_TIME=08:30
PM_DEPARTURE_TIME=18:00

# SF OpenData API endpoint (for crime data)
SF_OPENDATA_API_ENDPOINT=https://data.sfgov.org/resource/wg3w-h783.json

# Optional: SF OpenData App Token (not required but recommended for higher rate limits)
# Get from: https://data.sfgov.org/profile/edit/developer_settings
SF_OPENDATA_APP_TOKEN=

# Cache settings
# IMPORTANT: Must match the volume mount path in Railway
CACHE_DIR=/app/.cache
CACHE_EXPIRE_HOURS=168

# ============================================================================
# RAILWAY-SPECIFIC (automatically set by Railway)
# ============================================================================
# These are set automatically by Railway - DO NOT set them manually:
# - PORT (Railway assigns this)
# - RAILWAY_ENVIRONMENT
# - RAILWAY_SERVICE_NAME
# - RAILWAY_PROJECT_NAME
# - RAILWAY_DEPLOYMENT_ID

# ============================================================================
# OPTIONAL: Web Server Configuration
# ============================================================================

# Host (Railway sets this automatically, use default)
# HOST=0.0.0.0

# Flask debug mode (keep false in production)
# FLASK_DEBUG=false

# ============================================================================
# HOW TO USE THIS FILE
# ============================================================================
#
# 1. Open Railway dashboard → Your project → Your service
# 2. Click "Variables" tab
# 3. For each variable above (except Railway-specific ones):
#    a. Click "New Variable"
#    b. Enter the KEY (e.g., GOOGLE_SHEET_ID)
#    c. Enter your actual VALUE
#    d. Click "Add"
#
# SPECIAL NOTE FOR GOOGLE_SHEETS_CREDENTIALS_JSON:
# - Open credentials/google_sheets_credentials.json locally
# - Copy ALL of it (it's a JSON object with multiple lines)
# - In Railway, create variable GOOGLE_SHEETS_CREDENTIALS_JSON
# - Paste the entire JSON as the value (Railway handles newlines)
#
# ============================================================================

